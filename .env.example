# Copy to .env and fill in. Never commit .env.
ANAM_API_KEY=
# Optional. Default is the cartoon guide (1ebfe4f8-d568-40d1-8e25-5605942050e1).
# Realistic fallback ("Liv"): ANAM_AVATAR_ID=071b0286-4cce-4808-bee2-e642f1062de3
# ANAM_AVATAR_ID=
FAL_KEY=
ADAPTION_API_KEY=
ADAPTION_MODEL_ID=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
MONGODB_URI=
# Without MONGODB_URI, guides are saved as JSON files here (default <repo>/data/guides)
GUIDES_DIR=
ANTHROPIC_MODEL=
PICTURE_CONCURRENCY=9
# Optional extras (names only):
# Anam voices per language, e.g. ANAM_VOICE_ID_ES / _AR / _PL; ANAM_VOICE_ID_MULTI for other languages
# ANAM_VOICE_ID=
# ANAM_VOICE_ID_ES=
# ANAM_VOICE_ID_MULTI=
# ANAM_LLM_ID=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
# Most fal pictures per guide (default 4, 0 = none)
# PICTURE_CAP=4
# Shared code for a test link (every /api call then needs it)
# ACCESS_CODE=
# Demo-only switches, off by default
# SHOW_UNCHECKED_CLIPS=1
# DEVICE_PHOTO_LABELS=1
# EASYREAD_SHOW_CHECK=1
